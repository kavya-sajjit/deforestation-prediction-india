# Secrets — never commit these
.streamlit/secrets.toml
*service-account*.json
.env

# Large/raw data — keep the repo small
data/raw/
data/boundaries/*.shp
data/boundaries/*.dbf
data/boundaries/*.shx

# Python
__pycache__/
*.pyc
.venv/
venv/

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store

# v2 data and results (rebuilt by the pipeline)
data/v2/
results/**/model.pt
maps/*.tif

# large binaries live on the GitHub Release `v1-assets` (python scripts/fetch_assets.py)
models/*.pth
models/*.pt
models/*.pkl
data/satellite/
.pytest_cache/
